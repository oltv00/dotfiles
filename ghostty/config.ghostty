# NOTES
#
# Docs
# ghostty +show-config --default --docs | nvim
#
# Fonts
# ghostty +list-fonts
#
# Keybinds
# ghostty +list-keybinds
#
# Config examples
# https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

# Main settings
shell-integration = zsh

# Updates
auto-update = check
auto-update-channel = stable

# Theme & Appearance
theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf
window-colorspace = display-p3
unfocused-split-opacity = 0.97
background-opacity = 1.0

# Font
font-size = 18
font-family = "JetBrains Mono Regular"

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor, no-title
mouse-hide-while-typing = true

# Clipboard settings
copy-on-select = false
clipboard-read = deny
clipboard-write = deny
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# macOS options
# macos-titlebar-style = tabs # best for rectangle # hidden - for aerospace
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
macos-option-as-alt = right

# Working directory
working-directory = home
window-inherit-working-directory = false
window-inherit-font-size = true
tab-inherit-working-directory = false
split-inherit-working-directory = true

# Window
window-padding-x = 8
window-padding-y = 8
window-new-tab-position = end
# To fix quick-terminal-size, have to use window-save-state = never
# window-save-state = always
window-save-state = never

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s

# Scroll settings
scrollbar = never
mouse-scroll-multiplier = 0.75
scrollback-limit = 100000000

# Close
confirm-close-surface = false

# Quick terminal
quick-terminal-autohide = false
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-size = 75%,75%
quick-terminal-animation-duration = 0

# Keybinds
# super == cmd
# Global
keybind = global:option+`=toggle_quick_terminal
## Tab move
keybind = shift+ctrl+option+]=move_tab:+1
keybind = shift+ctrl+option+[=move_tab:-1
## Font size
keybind = all:super+0=reset_font_size
keybind = all:super+==increase_font_size:1
keybind = all:super+-=decrease_font_size:1
## Scroll
keybind = shift+arrow_down=jump_to_prompt:1
keybind = shift+arrow_up=jump_to_prompt:-1

keybind = super+shift+arrow_down=scroll_page_lines:3
keybind = super+shift+arrow_up=scroll_page_lines:-3

keybind = super+shift+j=scroll_page_lines:3
keybind = super+shift+k=scroll_page_lines:-3

keybind = super+ctrl+d=scroll_page_lines:12
keybind = super+ctrl+u=scroll_page_lines:-12

keybind = super+page_down=scroll_page_fractional:0.75
keybind = super+page_up=scroll_page_fractional:-0.75

## split
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

## new line
# keybind = shift+enter=text:\n
keybind = shift+enter=text:\x1b\r

