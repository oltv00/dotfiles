# NOTES
#
# Docs
# ghostty +show-config --default --docs | nvim
#
# Fonts
# ghostty +list-fonts
#
# Keybinds
# ghostty +list-keybinds
#
# Config examples
# https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

# Updates
auto-update = check
auto-update-channel = stable

# Theme
theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf

# Font
font-size = 18
font-family = "JetBrains Mono Regular"

# Background
background-opacity = 1.0

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor, no-title

# Clipboard settings
clipboard-read = ask
clipboard-write = ask

# macOS options
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden

# Working directory
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

# Window
window-padding-x = 8
window-padding-y = 8
window-new-tab-position = end
window-save-state = always

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell, notify
bell-features = system

# Scrollbar
scrollbar = never

# Close
confirm-close-surface = false