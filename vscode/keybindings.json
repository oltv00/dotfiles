[
    {
        "key": "shift+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && editorTextFocus && !editorReadonly"
    },

    {
        "key": "ctrl+space",
        "command": "-editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && editorTextFocus && !editorReadonly"
    },

    {
        "key": "ctrl+up",
        "command": "spaceBlockJumper.moveUp",
        "when": "editorTextFocus"
    },

    {
        "key": "ctrl+down",
        "command": "spaceBlockJumper.moveDown",
        "when": "editorTextFocus"
    },

    {
        "key": "ctrl+shift+up",
        "command": "spaceBlockJumper.selectUp",
        "when": "editorTextFocus"
    },

    {
        "key": "ctrl+shift+down",
        "command": "spaceBlockJumper.selectDown",
        "when": "editorTextFocus"
    },

    {
        "key": "cmd+alt+=",
        "command": "editor.action.fontZoomIn"
    },

    {
        "key": "cmd+alt+-",
        "command": "editor.action.fontZoomOut"
    },

    {
        "key": "cmd+alt+0",
        "command": "editor.action.fontZoomReset"
    },

    {
        "key": "shift+alt+cmd+0",
        "command": "workbench.action.zoomReset"
    },

    {
        "key": "cmd+b",
        "command": "-markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },

    {
        "key": "cmd+m",
        "command": "-markdown.extension.editing.toggleMath",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },

    {
        "key": "ctrl+l",
        "command": "center-editor-window.center",
        "when": "editorTextFocus || findWidgetVisible"
    },

    {
        "key": "cmd+r",
        "command": "markdown.preview.refresh"
    },

    {
        "key": "shift+cmd+j",
        "command": "workbench.action.toggleMaximizedPanel"
    },

    {
        "key": "ctrl+shift+cmd+n",
        "command": "explorer.newFile"
    },

    {
        "key": "ctrl+shift+f",
        "command": "workbench.action.quickTextSearch"
    },

    {
        "key": "cmd+; r",
        "command": "diffEditor.revert",
        "when": "isInDiffEditor"
    },

    {
        "key": "cmd+; s",
        "command": "diffEditor.switchSide",
        "when": "isInDiffEditor"
    },

    {
        "key": "cmd+; t",
        "command": "workbench.action.terminal.toggleTerminal"
    },

    {
        "key": "cmd+; m",
        "command": "workbench.actions.view.problems"
    },

    {
        "key": "cmd+; o",
        "command": "workbench.action.output.toggleOutput"
    },

    {
        "key": "cmd+; d",
        "command": "workbench.view.scm"
    },

    {
        "key": "shift+alt+cmd+-",
        "command": "workbench.action.decreaseViewSize"
    },

    {
        "key": "shift+alt+cmd+=",
        "command": "workbench.action.increaseViewSize"
    },

    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },

    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },

    {
        "key": "ctrl+j",
        "command": "-editor.action.joinLines",
        "when": "editorTextFocus && !editorReadonly"
    },

    {
        "key": "ctrl+k",
        "command": "-deleteAllRight",
        "when": "textInputFocus && !editorReadonly"
    },

    {
        "key": "ctrl+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible && textInputFocus"
    },

    {
        "key": "ctrl+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible && textInputFocus"
    },

    {
        "key": "cmd+k j",
        "command": "workbench.action.moveActiveEditorGroupDown"
    },

    {
        "key": "cmd+k j",
        "command": "views.moveViewDown",
        "when": "focusedView != ''"
    },

    {
        "key": "cmd+k l",
        "command": "views.moveViewRight",
        "when": "focusedView != ''"
    },

    {
        "key": "cmd+k l",
        "command": "workbench.action.moveActiveEditorGroupRight"
    },

    {
        "key": "cmd+k k",
        "command": "workbench.action.moveActiveEditorGroupUp"
    },

    {
        "key": "cmd+k k",
        "command": "views.moveViewUp",
        "when": "focusedView != ''"
    },

    {
        "key": "cmd+k h",
        "command": "workbench.action.moveActiveEditorGroupLeft"
    },

    {
        "key": "cmd+k h",
        "command": "views.moveViewLeft",
        "when": "focusedView != ''"
    },

    {
        "key": "cmd+l e",
        "command": "leetCodeExplorer.focus"
    },

    {
        "key": "cmd+k cmd+d",
        "command": "-editor.action.moveSelectionToNextFindMatch",
        "when": "editorFocus"
    },

    {
        "key": "cmd+k shift+cmd+left",
        "command": "-workbench.action.moveEditorLeftInGroup"
    },

    {
        "key": "cmd+k shift+cmd+right",
        "command": "-workbench.action.moveEditorRightInGroup"
    },

    {
        "key": "cmd+k cmd+l",
        "command": "-editor.toggleFold",
        "when": "editorTextFocus && foldingEnabled"
    },

    {
        "key": "cmd+k cmd+l",
        "command": "workbench.action.moveEditorToNextGroup"
    },

    {
        "key": "cmd+k cmd+h",
        "command": "workbench.action.moveEditorToPreviousGroup"
    },

    {
        "key": "cmd+c",
        "command": "-extension.vim_cmd+c",
        "when": "editorTextFocus && vim.active && vim.overrideCopy && vim.use<D-c> && !inDebugRepl"
    },
]

